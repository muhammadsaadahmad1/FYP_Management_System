{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Live Server",
            "type": "shell",
            "command": "npx",
            "args": [
                "live-server",
                "--port=5500",
                "--host=0.0.0.0",
                "--no-browser",
                "--open=/index.html"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "live-server",
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Serving"
                }
            }
        },
        {
            "label": "Stop Live Server",
            "type": "shell",
            "command": "taskkill",
            "args": [
                "/F",
                "/IM",
                "node.exe"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
